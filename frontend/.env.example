# ============================================================
# TELL ME PLEASE — переменные окружения для space.z-ai
# Скопируй этот файл в .env на платформе и заполни значения.
# НИКОГДА не коммить реальные ключи в репозиторий.
# ============================================================

# --- LLM (opencode zen) ---
# Один или несколько ключей через запятую (ротация на 429/403).
# Ключи создаются на https://opencode.ai — сам заливаешь сюда.
LLM_API_KEYS=key1,key2,key3

# Базовый URL OpenAI-совместимого API (менять не нужно).
LLM_API_BASE=https://opencode.ai/zen/v1

# Модели в порядке приоритета: primary первым, fallback дальше.
# Если primary вернул пустой ответ — сервер пробует следующую.
# Актуальные free-модели (проверено 31.07.2026):
LLM_MODELS=deepseek-v4-flash-free,ling-3.0-flash-free,nemotron-3-ultra-free

# --- Очередь LLM-запросов (защита от rate limit free-ключей) ---
# Максимум одновременных запросов к LLM (дефолт 8).
LLM_QUEUE_MAX=8
# Сколько ждать в очереди, если все слоты заняты (мс, дефолт 30000).
LLM_QUEUE_TIMEOUT=30000

# --- Админ-панель (скрытая, для учительницы) ---
# Обязательно задай реальный пароль. Без него админка не работает.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=смени-меня

# --- Аналитика ---
# Путь к файлу событий (дефолт: <cwd>/data/events.jsonl).
# ВАЖНО: файл живёт в контейнере платформы — при редеплое может очиститься.
# Для сбора цифр между деплоями — норм. Если нужна история — скачивай файл
# перед деплоем.
EVENTS_FILE=data/events.jsonl
