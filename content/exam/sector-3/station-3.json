      "options": [
        "will heat",
        "heat"
      ],
      "answer": "heat"
    },
    {
      "question": "If you heat ice, it ___.",
      "options": [
        "will melt",
        "melts"
      ],
      "answer": "melts"
    },
    {
      "question": "She will be angry if we ___ late.",
      "options": [
        "will be",
        "are"
      ],
      "answer": "are"
    },
    {
      "question": "We will go to the beach if the weather ___ fine.",
      "options": [
        "will be",
