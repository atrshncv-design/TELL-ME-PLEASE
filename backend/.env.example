LLM_API_KEYS=key1,key2,key3
LLM_API_BASE=https://opencode.ai/zen/v1
LLM_MODEL=ling-3.0-flash-free
# Ordered list of LLM models to try (primary first). If the primary returns
# empty content, the backend retries the next model. See config.get_models().
LLM_MODELS=ling-3.0-flash-free,nemotron-3-ultra-free
TTS_URL=http://localhost:8880/v1/audio/speech
TTS_VOICE=af_bella
# TTS backend: "http" (separate Kokoro container, local dev) or "kokoro"
# (in-process kokoro-onnx, for HF Spaces single-container). Default: http.
TTS_MODE=http
# Paths to the kokoro-onnx model + voices files. ONLY used when TTS_MODE=kokoro.
# The library does NOT bundle these; download from
#   https://github.com/thewh1teagle/kokoro-onnx/releases/tag/model-files-v1.0
# (kokoro-v1.0.onnx + voices-v1.0.bin) and place them in the working dir, or
# point these at absolute paths (e.g. HF Spaces /data mount).
TTS_KOKORO_MODEL=kokoro-v1.0.onnx
TTS_KOKORO_VOICES=voices-v1.0.bin
# HTTP Basic Auth password for /admin/* (decision Q13). Set a real value in
# your local gitignored .env. Empty/missing disables admin (returns 503).
ADMIN_PASSWORD=changeme
